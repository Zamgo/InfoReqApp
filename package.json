{
  "name": "inforeqapp",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "npm run ensure:schema && npm run sync:translations && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build:schema": "tsx scripts/build_schema_index.ts 4x3",
    "build:schema:4": "tsx scripts/build_schema_index.ts 4",
    "build:schema:all": "tsx scripts/build_schema_index.ts 4x3 && tsx scripts/build_schema_index.ts 4",
    "build:deprecated": "tsx scripts/build_deprecated_ifc.ts",
    "build:deprecated:4": "tsx scripts/build_deprecated_ifc.ts",
    "build:deprecated:all": "tsx scripts/build_deprecated_ifc.ts",
    "generate:ifc4-dictionary": "tsx scripts/generate_ifc4_dictionary.ts",
    "ensure:schema": "node scripts/checkSchemaIndex.js",
    "sync:translations": "node scripts/syncTranslations.js",
    "sync:img": "node -e \"const fs=require('fs');const p=require('path');const src='img';const dest='public/img';if(!fs.existsSync(dest))fs.mkdirSync(dest,{recursive:true});fs.readdirSync(src).forEach(f=>{const s=p.join(src,f);if(fs.statSync(s).isFile())fs.copyFileSync(s,p.join(dest,f));});console.log('img -> public/img synced');\""
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.18",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fast-xml-parser": "^4.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  }
}
